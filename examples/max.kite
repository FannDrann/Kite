// Находит максимальный элемент массива
func max(values: int[]): int {
    var result: int = values[0];
    var i: int = 1;
    while (i < len(values)) {
        if (values[i] > result) {
            result = values[i];
        }
        i = i + 1;
    }
    return result;
}

func main() {
    var values: int[] = new int[3];
    values[0] = 7;
    values[1] = 42;
    values[2] = 15;
    print(max(values));
}
